{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo No dependencies to install",
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://musicbrainz.org; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
    ]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/offline-assets.json","headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ]
}
